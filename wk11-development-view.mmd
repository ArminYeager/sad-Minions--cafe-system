flowchart TB
    subgraph ClientSide["ส่วนแสดงผล (Presentation Layer)"]
        UI["คอมโพเนนต์หน้าจอผู้ใช้ (Web UI)<br/>ฟอร์ม POS, จัดการเมนู, รายงานยอดขาย<br/>HTML / CSS / JavaScript"]
    end

    subgraph ServerSide["ส่วนแอปพลิเคชันแบ็กเอนด์: Node.js / Express (src/)"]
        subgraph RouteLayer["ชั้นจัดการเส้นทาง (Routes Layer - src/routes/)"]
            OrderRoute["orderRoutes.js<br/>- เส้นทางสั่งซื้อ /api/orders"]
            MenuRoute["menuRoutes.js<br/>- เส้นทางเมนู /api/menu"]
            ReportRoute["reportRoutes.js<br/>- เส้นทางรายงาน /api/reports/sales"]
        end

        subgraph ControllerLayer["ชั้นควบคุมตรรกะธุรกิจ (Controllers Layer - src/controllers/)"]
            OrderController["orderController.js<br/>- ตรวจสอบความถูกต้องของข้อมูล Validation<br/>- คำนวณสรุปและจัดกลุ่มรายการสินค้า<br/>- ตรวจสอบแจ้งเตือนสต็อกต่ำ"]
            MenuController["menuController.js<br/>- จัดการเพิ่ม ลบ แก้ไข และค้นหาเมนู"]
            ReportController["reportController.js<br/>- ประมวลผลและสรุปยอดขายตามช่วงเวลา"]
        end

        subgraph DomainLayer["ชั้นคลาสโดเมน (Domain Classes)"]
            OrderClass["orderModel.js หรือ Order.js<br/>- คลาสคำสั่งซื้อ Order<br/>- คลาสรายการสินค้า OrderItem<br/>- ฟังก์ชันคำนวณยอด getSubtotal()"]
            MenuClass["menuModel.js<br/>- คลาสเมนูอาหาร MenuItem"]
        end

        subgraph DataAccessLayer["ชั้นเข้าถึงข้อมูล (Data-access Models - src/models/)"]
            OrderDataAccess["orderModel.js ฟังก์ชันจัดการฐานข้อมูล<br/>- บันทึกคำสั่งซื้อ create()<br/>- บันทึกรายการสินค้า addItem()"]
            MenuDataAccess["menuModel.js ฟังก์ชันจัดการฐานข้อมูล<br/>- ตรวจสอบสต็อก findManyForStockCheck()<br/>- ตัดสต็อกสินค้า deductStock()"]
        end

        subgraph ConfigLayer["ชั้นกำหนดค่าระบบ (Configuration Layer - src/config/)"]
            DBConfig["db.js<br/>- พูลเชื่อมต่อฐานข้อมูล Connection Pool<br/>- จัดการการเชื่อมต่อกับ MySQL"]
        end
    end

    subgraph Database["ชั้นฐานข้อมูล (Database Tier - MySQL)"]
        MySQLDB[("ฐานข้อมูล MySQL: cafe_pos<br/>ตาราง: orders, order_item, menu_item,<br/>category, branch, employee, stock_movement")]
    end

    UI -->|"เรียกใช้งาน API ผ่าน HTTP Fetch"| RouteLayer
    OrderRoute --> OrderController
    MenuRoute --> MenuController
    ReportRoute --> ReportController

    OrderController -->|"สร้างอ็อบเจกต์และคำนวณราคา"| OrderClass
    MenuController -->|"สร้างอ็อบเจกต์"| MenuClass

    OrderController -->|"เรียกบันทึกข้อมูลและตัดสต็อก"| OrderDataAccess
    OrderController -->|"เรียกตรวจสอบสต็อกสินค้า"| MenuDataAccess
    MenuController --> MenuDataAccess

    OrderDataAccess --> DBConfig
    MenuDataAccess --> DBConfig
    ReportController --> DBConfig

    DBConfig -->|"ประมวลผลคำสั่ง SQL Queries"| MySQLDB
